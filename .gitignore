# Private notes and research — never committed.
/.research/
/.notes/

# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Node / Tauri frontend
/app/node_modules/
/app/.svelte-kit/
/app/build/
/app/src-tauri/target/
/app/src-tauri/gen/

# Editors / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Local environment
.env
.env.local
*.local

# Generated / runtime
*.log
/tmp/

# makepkg build artefacts inside packaging/ — the PKGBUILD itself
# is committed, but the package output and the makepkg working
# directories are local-only.
/packaging/*.pkg.tar.*
/packaging/pkg/
/packaging/src/
