[Unit]
Description=ludex gameplay-time tracker daemon
Documentation=https://github.com/embernode/ludex
# Start after the user session's graphical target is up — KWin has
# to be running before the foreground-window source can register
# its script. The daemon also tolerates a missing compositor
# (logs a warning, foreground source disabled), but the common
# case is a KDE login.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Default to the cargo-install location the README documents.
# Package builds (e.g. the AUR PKGBUILD) that drop the binary at
# /usr/bin/ludex-daemon install a copy of this unit with that
# path substituted.
ExecStart=%h/.cargo/bin/ludex-daemon

# On crash, wait five seconds then restart. Don't restart on a
# clean shutdown (SIGTERM at logout) — that's the user asking us
# to go away.
Restart=on-failure
RestartSec=5s

# Soft hardening for an unprivileged user daemon. Kept to options
# that don't break the daemon's core job of reading other processes'
# /proc. NoNewPrivileges is safe; PrivateTmp is deliberately NOT set —
# on a --user service systemd implements it via a user namespace, and
# from inside that namespace ptrace_may_access() denies reading
# /proc/<pid>/exe for host processes, so every foreground window would
# be rejected as ExeUnreadable and no game would ever be tracked.
NoNewPrivileges=true

[Install]
WantedBy=default.target
