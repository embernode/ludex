[Desktop Entry]
Type=Application
Name=ludex
GenericName=Gameplay Time Tracker
Comment=Linux gameplay time tracker
Exec=ludex-gui
Icon=net.ludex.gui
Terminal=false
Categories=Game;Utility;
Keywords=games;playtime;tracker;steam;
StartupNotify=true
# Tauri 2 sets the GTK application id from `tauri.conf.json`'s
# `identifier` (net.ludex.gui), but on Wayland the wry backend
# ends up calling `xdg_toplevel.set_app_id` with the *binary
# basename* (`ludex-gui`) instead. KDE's task manager reads the
# Wayland app-id when matching windows to .desktop entries, so
# `StartupWMClass` here has to match what actually reaches the
# compositor — the binary name — not the reverse-DNS bundle id.
# Confirm via:
#   qdbus6 org.kde.KWin /KWin org.kde.KWin.queryWindowInfo
# (click the GUI window when prompted; the `desktopFile` field
# is what KDE expects this entry to be named/match against).
StartupWMClass=ludex-gui
